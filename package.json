{
  "name": "@hradigital/smartforms",
  "version": "1.0.0",
  "description": "State-aware client-side form manager for static HTML forms. Tracks per-field state (new, unchanged, changed, invalid, empty) and toggles toolbar actions accordingly.",
  "keywords": [
    "form",
    "validation",
    "form-state",
    "html-form",
    "toolbar",
    "client-side",
    "no-framework"
  ],
  "license": "MPL-2.0",
  "author": "HraDigital",
  "homepage": "https://github.com/HraDigital/smartforms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HraDigital/smartforms.git"
  },
  "bugs": {
    "url": "https://github.com/HraDigital/smartforms/issues"
  },
  "type": "module",
  "main": "./dist/smartforms.cjs",
  "module": "./dist/smartforms.mjs",
  "browser": "./dist/smartforms.umd.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/smartforms.mjs",
      "require": "./dist/smartforms.cjs",
      "default": "./dist/smartforms.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "TRADEMARK.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests,types,examples}/**/*.{js,ts}\"",
    "format:check": "prettier --check \"{src,tests,types,examples}/**/*.{js,ts}\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run format:check && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "eslint": "^10.0.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.2.0",
    "rollup": "^4.13.0",
    "semantic-release": "^25.0.9",
    "vitest": "^4.1.0"
  }
}
